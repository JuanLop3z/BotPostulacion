# Personal local workspace, without login. The secret encrypts CV documents.
# Copy to .env. Generate your own key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-private-value-at-least-32-characters
ENVIRONMENT=local
# Docker uses the database service automatically; local defaults to storage/autojob.db (SQLite).
# DATABASE_URL=postgresql+psycopg://autojob:local-only-change-me@localhost:5432/autojob
POSTGRES_PASSWORD=local-only-change-me
REDIS_URL=redis://localhost:6379/0
INLINE_TASKS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: select a specific existing owner before the first launch of this personal version.
LOCAL_USER_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
TIMEZONE=America/Bogota
RETENTION_DAYS=90
# Optional user-owned JSON gateway; see docs/ai-gateway.md. No credentials in context files.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=generic
EMBEDDING_MODEL=nomic-embed-text
ENABLE_EMBEDDINGS=false
